# The services in compose.yaml, for the tests (ROLLOUT_TEST_*) and for servers (ROLLOUT_DATABASE, ROLLOUT_BLOBS).
ROLLOUT_TEST_POSTGRES=postgresql://rollout:rollout@localhost:5432/rollout
ROLLOUT_TEST_S3=http://localhost:7070
ROLLOUT_DATABASE=postgresql://rollout:rollout@localhost:5432/rollout
ROLLOUT_BLOBS=s3://rollout-blobs/blobs
AWS_ENDPOINT_URL=http://localhost:7070
AWS_ACCESS_KEY_ID=rollout
AWS_SECRET_ACCESS_KEY=rollout-secret
AWS_DEFAULT_REGION=us-east-1
