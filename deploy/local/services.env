# The services in compose.yaml, for the tests (ROLLOUT_TEST_*) and for a cluster config (ROLLOUT_LEDGER_URL, AWS_*).
ROLLOUT_TEST_POSTGRES=postgresql://rollout:rollout@localhost:5432/rollout
ROLLOUT_TEST_S3=http://localhost:7070
ROLLOUT_LEDGER_URL=postgresql://rollout:rollout@localhost:5432/rollout
AWS_ENDPOINT_URL=http://localhost:7070
AWS_ACCESS_KEY_ID=rollout
AWS_SECRET_ACCESS_KEY=rollout-secret
AWS_DEFAULT_REGION=us-east-1
